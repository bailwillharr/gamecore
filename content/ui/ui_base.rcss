/*
 * The engine's base style sheet for UI documents (see gamecore/include/gamecore/gc_ui.h). Link it before a document's own sheets:
 *     <link type="text/rcss" href="ui_base.rcss"/>
 * RmlUi has no default styles of its own, so this gives the HTML-like elements the display they are expected to have (from
 * RmlUi's samples, rml.rcss), and gives the body the engine's font.
 *
 * Sizes are in dp, which scale with the screen (see gc::UIScaling). Prefer dp, %, vw and vh to px.
 */

body
{
	font-family: LatoLatin;
	font-weight: normal;
	font-style: normal;
	font-size: 16dp;
	color: #ffffff;
}

div, p, h1, h2, h3, h4
{
	display: block;
}

h1 { font-size: 2em; font-weight: bold; }
h2 { font-size: 1.5em; font-weight: bold; }
h3 { font-size: 1.17em; font-weight: bold; }
h4 { font-weight: bold; }

em { font-style: italic; }
strong { font-weight: bold; }

select { text-align: left; }

tabset tabs { display: block; }

table { box-sizing: border-box; display: table; }
tr { box-sizing: border-box; display: table-row; }
td { box-sizing: border-box; display: table-cell; }
col { box-sizing: border-box; display: table-column; }
colgroup { display: table-column-group; }
thead, tbody, tfoot { display: table-row-group; }

/*
 * A document that is only something to look at (a HUD) should let the mouse through to the game. Give its body this class:
 * <body class="overlay">. Anything in it that should be clicked can have pointer-events: auto.
 */
body.overlay
{
	pointer-events: none;
	width: 100%;
	height: 100%;
}
